{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icao.int/hao/schemas/hao-ontology.schema.json",
  "title": "HAO ontology (assembled, BFO-conformant)",
  "description": "The ontology as assembled from its parts. Every domain class declares the single BFO class it specialises.",
  "$comment": "Classes may be split across several part files; ids must be unique across all of them.",
  "type": "object",
  "required": [
    "meta",
    "bfoBackbone",
    "relations",
    "classes",
    "axioms"
  ],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "$ref": "parts/ontology-meta.schema.json"
    },
    "bfoBackbone": {
      "$ref": "parts/ontology-bfo-backbone.schema.json"
    },
    "relations": {
      "$ref": "parts/ontology-relations.schema.json"
    },
    "classes": {
      "$ref": "parts/ontology-classes.schema.json"
    },
    "axioms": {
      "$ref": "parts/ontology-axioms.schema.json"
    },
    "modellingNotes": {
      "$ref": "parts/ontology-notes.schema.json"
    }
  }
}
