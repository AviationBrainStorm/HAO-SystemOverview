{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icao.int/hao/schemas/parts/flight-phases.schema.json",
  "title": "HAO flight phases",
  "description": "Ordered design phases. Mounts at dataset.flightPhases.",
  "$comment": "Governs the `payload` of a data part. The part file itself is validated against hao-part.schema.json.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^PH-[A-Z0-9]+$"
      },
      "name": {
        "type": "string"
      },
      "order": {
        "type": "integer"
      }
    }
  }
}
