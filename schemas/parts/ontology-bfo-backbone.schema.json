{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icao.int/hao/schemas/parts/ontology-bfo-backbone.schema.json",
  "title": "BFO backbone",
  "description": "The BFO classes the domain specialises. Mounts at ontology.bfoBackbone.",
  "$comment": "Governs the `payload` of a data part. The part file itself is validated against hao-part.schema.json.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "label"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^bfo:"
      },
      "label": {
        "type": "string"
      },
      "parent": {
        "type": [
          "string",
          "null"
        ]
      },
      "note": {
        "type": "string"
      }
    }
  }
}
