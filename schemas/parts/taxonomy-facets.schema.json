{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icao.int/hao/schemas/parts/taxonomy-facets.schema.json",
  "title": "HAO taxonomy facets",
  "description": "Orthogonal facets with arbitrarily nested terms. Mounts at taxonomy.facets.",
  "$comment": "Governs the `payload` of a data part. The part file itself is validated against hao-part.schema.json.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "terms"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^F[0-9]+$"
      },
      "name": {
        "type": "string"
      },
      "note": {
        "type": "string"
      },
      "terms": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/term"
        }
      }
    }
  },
  "$defs": {
    "term": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          }
        }
      }
    }
  }
}
