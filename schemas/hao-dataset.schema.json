{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icao.int/hao/schemas/hao-dataset.schema.json",
  "title": "HAO Navigator dataset",
  "description": "Root schema for the Higher Airspace Operations Navigator. Upload a document conforming to this schema to replace the seed data. Space vehicles (orbital, suborbital, launch, re-entry) are out of scope.",
  "type": "object",
  "required": [
    "meta",
    "vehicleClasses",
    "flightPhases",
    "scenarios",
    "provisionGaps",
    "expertGroups"
  ],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "datasetId",
        "title",
        "version"
      ],
      "properties": {
        "datasetId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "issued": {
          "type": "string",
          "format": "date"
        },
        "scopeNote": {
          "type": "string"
        },
        "holisticVision": {
          "type": "string"
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "referenceAirspace": {
      "type": "object",
      "properties": {
        "bands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "fromFt",
              "toFt"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "fromFt": {
                "type": "number",
                "minimum": 0
              },
              "toFt": {
                "type": "number",
                "minimum": 0
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "altimetryNote": {
          "type": "string"
        }
      }
    },
    "vehicleClasses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "liftPrinciple"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VC-[A-Z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "shortName": {
            "type": "string"
          },
          "liftPrinciple": {
            "type": "string",
            "description": "Must describe lift derived from interaction with the atmosphere. Vehicles that do not derive lift from the atmosphere are out of scope."
          },
          "crewing": {
            "type": "string"
          },
          "typicalFloatFt": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "controlAuthority": {
            "type": "string"
          },
          "enduranceTypical": {
            "type": "string"
          },
          "exemplars": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "regulatoryAnchor": {
            "type": "string"
          },
          "colour": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "flightPhases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PH-[A-Z0-9]+$"
          },
          "name": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
        }
      }
    },
    "useCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UC-[A-Z0-9]+$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "serviceCatalogue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "gatmoc": {
            "type": "string"
          }
        }
      }
    },
    "gatmoc": {
      "type": "object",
      "properties": {
        "components": {
          "$ref": "#/$defs/idNameList"
        },
        "guidingPrinciples": {
          "$ref": "#/$defs/idNameList"
        },
        "kpas": {
          "$ref": "#/$defs/idNameList"
        },
        "atmCommunity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ganp": {
      "type": "object",
      "properties": {
        "layers": {
          "$ref": "#/$defs/idNameList"
        },
        "bbb": {
          "$ref": "#/$defs/idNameList"
        },
        "asbuThreads": {
          "$ref": "#/$defs/idNameList"
        }
      }
    },
    "expertGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "provisionGaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provisionGap"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "firRegions": {
      "type": "array",
      "description": "Schematic FIR / sovereign region boxes for the plan view. Not for navigation.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "bbox"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FIR-[A-Z0-9]+$"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "sovereign",
              "oceanic",
              "highSeas"
            ]
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[lonMin, latMin, lonMax, latMax] in WGS84 degrees."
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "jobCards": {
      "type": "array",
      "description": "ICAO work programme job cards, using the Delivery / Effective / Applicability triple.",
      "items": {
        "$ref": "#/$defs/jobCard"
      }
    }
  },
  "$defs": {
    "idNameList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "provisionGap": {
      "type": "object",
      "required": [
        "id",
        "title",
        "instrument",
        "gapType",
        "severity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GAP-[A-Z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "instrument": {
          "type": "string",
          "description": "The ICAO Annex, PANS, Doc or other instrument affected."
        },
        "reference": {
          "type": "string",
          "description": "Chapter, appendix or paragraph reference."
        },
        "gapType": {
          "type": "string",
          "enum": [
            "Amendment",
            "New provision",
            "Guidance material",
            "Clarification",
            "No change required"
          ]
        },
        "severity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "0 = none, 5 = blocking. Drives the gap heat scale."
        },
        "description": {
          "type": "string"
        },
        "proposedAction": {
          "type": "string"
        },
        "owningGroups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Expert group ids."
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "vehicleClassId",
        "phaseId",
        "name",
        "trajectory"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SC-[A-Z0-9-]+$"
        },
        "vehicleClassId": {
          "type": "string"
        },
        "phaseId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "narrative": {
          "type": "string"
        },
        "useCases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "altitudeBandFt": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "trajectory": {
          "type": "array",
          "minItems": 2,
          "description": "Ordered design flight path samples. t is normalised 0-1 along the scenario, altFt is pressure altitude in feet.",
          "items": {
            "type": "object",
            "required": [
              "t",
              "altFt"
            ],
            "properties": {
              "t": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "altFt": {
                "type": "number",
                "minimum": 0
              },
              "label": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "otherTraffic": {
          "type": "array",
          "description": "Traffic the design path intersects or passes. Bands are altitude layers; crossings are point encounters.",
          "items": {
            "type": "object",
            "required": [
              "type",
              "label"
            ],
            "oneOf": [
              {
                "properties": {
                  "type": {
                    "const": "band"
                  }
                },
                "required": [
                  "fromFt",
                  "toFt"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "crossing"
                  }
                },
                "required": [
                  "atT",
                  "altFt"
                ]
              }
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "band",
                  "crossing"
                ]
              },
              "label": {
                "type": "string"
              },
              "fromFt": {
                "type": "number"
              },
              "toFt": {
                "type": "number"
              },
              "atT": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "altFt": {
                "type": "number"
              },
              "density": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "conflictRisk": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        },
        "atsInteraction": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "responsibilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Service catalogue ids."
        },
        "cns": {
          "type": "object",
          "required": [
            "communication",
            "navigation",
            "surveillance"
          ],
          "properties": {
            "communication": {
              "type": "string"
            },
            "navigation": {
              "type": "string"
            },
            "surveillance": {
              "type": "string"
            }
          }
        },
        "equipage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "informationRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provisionGaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Provision gap ids."
        },
        "mapping": {
          "type": "object",
          "properties": {
            "gatmocComponents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kpas": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "guidingPrinciples": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ganpLayers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "asbuThreads": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "bbb": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "expertGroupDependency": {
          "type": "object",
          "description": "Map of expert group id to dependency level 0-5. Drives the heat map.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "groundTrack": {
          "type": "object",
          "description": "Geographic ground track for the plan view.",
          "required": [
            "waypoints"
          ],
          "properties": {
            "waypoints": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "lat",
                  "lon",
                  "altFt"
                ],
                "properties": {
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lon": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "altFt": {
                    "type": "number",
                    "minimum": 0
                  },
                  "label": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            },
            "firCrossings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "atIndex",
                  "from",
                  "to"
                ],
                "properties": {
                  "atIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Index into waypoints."
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "sovereign",
                      "oceanic",
                      "toHighSeas",
                      "regimeChange",
                      "internal"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            },
            "stationArea": {
              "type": "object",
              "required": [
                "lat",
                "lon",
                "radiusKm"
              ],
              "properties": {
                "lat": {
                  "type": "number"
                },
                "lon": {
                  "type": "number"
                },
                "radiusKm": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "uncertaintyGrowth": {
              "type": "boolean",
              "description": "Render a widening uncertainty cone (loss of telemetry)."
            },
            "dueRegard": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "jobCard": {
      "type": "object",
      "required": [
        "id",
        "title",
        "primaryGroup",
        "status",
        "workProgrammeElements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "ICAO job card reference, e.g. SASP.019.01. Use a placeholder plus idProvisional when unassigned."
        },
        "idProvisional": {
          "type": "boolean",
          "description": "True when the ANC has not yet assigned a reference number."
        },
        "title": {
          "type": "string"
        },
        "primaryGroup": {
          "type": "string",
          "description": "Expert group id."
        },
        "supportingGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "Approved",
            "On-schedule",
            "Re-scheduled",
            "Delivered",
            "Completed",
            "Cancelled",
            "Superseded"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "High",
            "Medium",
            "Low"
          ]
        },
        "source": {
          "type": "string"
        },
        "problemStatement": {
          "type": "string"
        },
        "ganpGaspLink": {
          "type": "string"
        },
        "proposedMetric": {
          "type": "string"
        },
        "interdependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expectedBenefits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secretariatCoordinator": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "workProgrammeElements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "wpe",
              "description",
              "status"
            ],
            "properties": {
              "wpe": {
                "type": "string",
                "description": "Work programme element number or code."
              },
              "documentAffected": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "supportingGroups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "Proposed",
                  "On-schedule",
                  "Re-scheduled",
                  "Delivered",
                  "Completed",
                  "Cancelled"
                ]
              },
              "delivery": {
                "type": "string",
                "description": "ICAO date form: 'Q2 2028', 'Nov 2028', 'Dec 2025' or '2028'."
              },
              "effective": {
                "type": "string"
              },
              "applicability": {
                "type": "string"
              }
            }
          }
        },
        "addressesGaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "gapId",
              "coverage"
            ],
            "properties": {
              "gapId": {
                "type": "string"
              },
              "coverage": {
                "type": "string",
                "enum": [
                  "resolving",
                  "partial",
                  "framing"
                ],
                "description": "resolving = output changes the provision; partial = work exists but does not span the gap; framing = scoped conceptually only."
              }
            }
          }
        }
      }
    }
  }
}