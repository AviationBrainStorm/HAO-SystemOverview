{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icao.int/hao/schemas/hao-dataset.schema.json",
  "title": "HAO Navigator dataset (assembled)",
  "description": "The dataset as assembled at runtime from the parts in data/parts/. Each property is governed by its own part schema, so a single collection can be validated on its own. Space vehicles (orbital, suborbital, launch, re-entry) are out of scope.",
  "$comment": "Cross-part referential integrity (scenario -> vehicle class, gap, service, expert group; job card -> gap) is outside what JSON Schema can express. It is enforced at load time by js/data-registry.js and by tools/validate-parts.mjs.",
  "type": "object",
  "required": [
    "meta",
    "vehicleClasses",
    "flightPhases",
    "scenarios",
    "provisionGaps",
    "expertGroups"
  ],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "$ref": "parts/meta.schema.json"
    },
    "referenceAirspace": {
      "$ref": "parts/reference-airspace.schema.json"
    },
    "vehicleClasses": {
      "$ref": "parts/vehicle-classes.schema.json"
    },
    "flightPhases": {
      "$ref": "parts/flight-phases.schema.json"
    },
    "useCases": {
      "$ref": "parts/use-cases.schema.json"
    },
    "serviceCatalogue": {
      "$ref": "parts/service-catalogue.schema.json"
    },
    "gatmoc": {
      "type": "object",
      "description": "Assembled from four independent parts.",
      "properties": {
        "components": {
          "$ref": "parts/gatmoc-components.schema.json"
        },
        "guidingPrinciples": {
          "$ref": "parts/guiding-principles.schema.json"
        },
        "kpas": {
          "$ref": "parts/kpas.schema.json"
        },
        "atmCommunity": {
          "$ref": "parts/atm-community.schema.json"
        }
      }
    },
    "ganp": {
      "type": "object",
      "description": "Assembled from three independent parts.",
      "properties": {
        "layers": {
          "$ref": "parts/ganp-layers.schema.json"
        },
        "bbb": {
          "$ref": "parts/ganp-bbb.schema.json"
        },
        "asbuThreads": {
          "$ref": "parts/ganp-asbu-threads.schema.json"
        }
      }
    },
    "expertGroups": {
      "$ref": "parts/expert-groups.schema.json"
    },
    "provisionGaps": {
      "$ref": "parts/provision-gaps.schema.json"
    },
    "scenarios": {
      "$ref": "parts/scenarios.schema.json"
    },
    "jobCards": {
      "$ref": "parts/job-cards.schema.json"
    },
    "firRegions": {
      "$ref": "parts/fir-regions.schema.json"
    }
  }
}
