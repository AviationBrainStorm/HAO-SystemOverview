{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icao.int/hao/schemas/hao-taxonomy.schema.json",
  "title": "HAO faceted taxonomy",
  "description": "Schema for a faceted taxonomy of Higher Airspace Operations. Terms may nest to any depth within a facet, but facets themselves are orthogonal.",
  "type": "object",
  "required": ["meta", "facets"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["taxonomyId", "title", "version"],
      "properties": {
        "taxonomyId": { "type": "string" },
        "title": { "type": "string" },
        "version": { "type": "string" },
        "structure": { "type": "string" },
        "scopeExclusion": { "type": "string" }
      }
    },
    "facets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "terms"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]+$" },
          "name": { "type": "string" },
          "note": { "type": "string" },
          "terms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/term" } }
        }
      }
    },
    "workedExamples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "coding"],
        "properties": {
          "label": { "type": "string" },
          "coding": {
            "type": "object",
            "description": "Map of facet id to one term id or an array of term ids.",
            "additionalProperties": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "term": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "note": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/term" } }
      }
    }
  }
}
